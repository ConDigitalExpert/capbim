{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/capbim/stage-report.schema.json",
  "title": "StageReport",
  "description": "Written by every pipeline stage. The orchestrator reads status/checks to decide pass, retry (bounded ladder) or human gate.",
  "type": "object",
  "required": ["job_id", "stage_id", "stage_name", "attempt", "status", "started_at", "finished_at", "software", "params", "inputs", "outputs", "metrics", "checks"],
  "properties": {
    "job_id": {"type": "string"},
    "stage_id": {"type": "string", "pattern": "^[0-9]{2}[a-z]?$"},
    "stage_name": {"type": "string"},
    "space_class": {"enum": ["S", "M", "L"]},
    "attempt": {"type": "integer", "minimum": 1},
    "status": {"enum": ["pass", "warn", "fail", "blocked", "skipped"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "software": {
      "type": "array",
      "items": {"type": "object", "required": ["name", "version"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "host": {"type": "string"}}}
    },
    "params": {"type": "object", "description": "Exact parameters used in this attempt (serialisable)."},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "metrics": {"type": "object", "description": "All measured values, in mm / px / fractions as named."},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "metric", "operator", "threshold", "value", "result", "severity"],
        "properties": {
          "id": {"type": "string"},
          "metric": {"type": "string"},
          "operator": {"enum": ["<=", "<", ">=", ">", "==", "in"]},
          "threshold": {},
          "value": {},
          "result": {"enum": ["pass", "fail", "warn", "n/a"]},
          "severity": {"enum": ["blocking", "warning"]},
          "threshold_source": {"type": "string", "description": "path in qc-thresholds.yaml"},
          "note": {"type": "string"}
        }
      }
    },
    "retry": {
      "type": "object",
      "properties": {
        "allowed": {"type": "boolean"},
        "ladder_step_next": {"type": "integer", "minimum": 0},
        "ladder_max": {"type": "integer"},
        "param_changes": {"type": "object"},
        "reason": {"type": "string"}
      }
    },
    "human_gate": {
      "type": "object",
      "properties": {
        "required": {"type": "boolean"},
        "summary": {"type": "string"},
        "items": {"type": "array", "items": {"type": "string"}},
        "viewer_url": {"type": "string"}
      }
    },
    "log_path": {"type": "string"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "kind": {"type": "string"},
        "bytes": {"type": "integer"},
        "sealed": {"type": "boolean", "description": "true for the blind independent-check file until stage 10"}
      }
    }
  }
}
